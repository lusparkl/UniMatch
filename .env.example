DATABASE_URL=postgresql://unimatch:unimatch_local@localhost:5434/unimatch
REDIS_URL=redis://localhost:6381
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# DEMO_FIXTURES uses fictional in-memory data; false uses PostgreSQL.
DEMO_MODE=DEMO_FIXTURES
MAX_CRAWL_PAGES=12
MAX_CRAWL_DEPTH=3
MAX_CONCURRENT_CRAWLS=2
CRAWL_DELAY_MS=2000
MAX_CONTENT_BYTES=2000000
MAX_AI_CALLS_PER_JOB=6
MAX_AI_CONCURRENCY=1
MAX_AI_OUTPUT_TOKENS=4000
DAILY_AI_TOKEN_LIMIT=500000
AI_TIMEOUT_MS=60000
# The demo deployment uses 30 so deadlines stay usable between refreshes.
FRESHNESS_DEADLINE_DAYS=7
FRESHNESS_SCHOLARSHIP_DAYS=30
FRESHNESS_METADATA_DAYS=90
# Destinations students see (comma-separated); other seeded countries stay hidden.
ENABLED_COUNTRIES=Hong Kong,South Korea
# true: public deployment without admin, accounts or Redis.
PUBLIC_MODE=false
# db reads PostgreSQL; snapshot reads data/catalog-snapshot.json (npm run catalog:export).
CATALOG_SOURCE=db
# Optional: another snapshot file, relative to the app directory.
# CATALOG_SNAPSHOT_PATH=data/catalog-snapshot.json

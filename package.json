{
  "name": "unimatch-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -k \"npm:dev\" \"npm:worker\"",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx --env-file=.env worker/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "schedule": "tsx --env-file=.env scripts/schedule.ts",
    "admin:password": "tsx scripts/password.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:model": "tsx --env-file=.env scripts/model-smoke.ts",
    "test:cost": "tsx --env-file=.env scripts/cost-benchmark.ts",
    "test:live": "tsx --env-file=.env scripts/live-smoke.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:crawl": "tsx --env-file=.env scripts/crawl-smoke.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.70.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crawlee": "^3.18.2",
    "dotenv": "^17.3.1",
    "ioredis": "^5.9.0",
    "ipaddr.js": "^2.3.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "playwright": "^1.58.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "robots-parser": "^3.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "pdfkit": "^0.17.2",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
